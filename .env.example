# --- Base de datos ---
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=cambie-esta-clave
POSTGRES_DB=asistencia

# --- API ---
ENVIRONMENT=development          # production en AWS
SECRET_KEY=genere-una-con: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false              # true cuando haya HTTPS
TIMEZONE=America/El_Salvador
DOUBLE_TAP_SECONDS=120           # marcas repetidas dentro de esta ventana = doble marca

# Administrador inicial (solo se crea si la base no tiene usuarios)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=cambie-esta-clave-tambien

# --- Archivos del reloj ---
STORAGE_BACKEND=local            # s3 en AWS
# S3_BUCKET=connecting-asistencia-attlogs
# AWS_REGION=us-east-1

WEB_PORT=8080
